# Archivo de ejemplo para configuración de entorno
# Copiar este archivo a .env y reemplazar con valores reales

# Autenticación Local
SECRET_KEY=cambiar_en_produccion
LDAP_SERVER=ldap://dominio.com
LDAP_USER=admin
LDAP_PASSWORD=secreto

# Configuración de Microsoft Entra ID (Graph API)
ENTRA_TENANT_ID=tu_tenant_id_aqui
ENTRA_CLIENT_ID=tu_client_id_aqui
ENTRA_CLIENT_SECRET=tu_client_secret_aqui
